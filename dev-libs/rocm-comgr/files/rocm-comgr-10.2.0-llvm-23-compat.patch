+// LLVM 24's frontend feature bitset, restricted to the features COMGR
+// tests.  Names mirror the FEAT_* enumerators that TableGen derives from
+// AMDGPU feature names (upper case, '-' converted to '_').
+enum : unsigned {
+  FEAT_IMAGE_INSTS = 1u << 0,
+  FEAT_GFX10_INSTS = 1u << 1,
+  FEAT_GFX10_3_INSTS = 1u << 2,
+  FEAT_GFX90A_INSTS = 1u << 3,
+  FEAT_1536_PHYSICAL_VGPRS = 1u << 4,
+  FEAT_1024_ADDRESSABLE_VGPRS = 1u << 5,
+  FEAT_HALF_ADDRESSABLE_PHYSICAL_LOCAL_MEMORY = 1u << 6,
+  FEAT_XNACK_ON_OFF_MODES = 1u << 7,
+  FEAT_SRAMECC_SUPPORT = 1u << 8,
+};
+
+// Per-ISA metadata as recorded by the therock-10.2 LLVM fork (the LLVM 24
+// base of ROCm 10.2).  Generated from llvm/lib/Target/AMDGPU/AMDGPU.td and
+// GCNProcessors.td by replicating -gen-amdgpu-target-def
+// (llvm/utils/TableGen/Basic/AMDGPUTargetDefEmitter.cpp): the bitset is the
+// transitive closure of each AMDGPUProcessorModel Features list following
+// Implies edges, and the numerics follow getFeatureValue() with the
+// emitter defaults (MaxWavesPerEU 10, AddressableLocalMemorySize 32768,
+// LDSBankCount 32).  Rows are keyed on the GPUKind enumerators of the LLVM
+// 23 TargetParser and cover every GPU its AMDGPUTargetParser.def
+// enumerates.
+struct IsaTableEntry {
+  GPUKind Kind;
+  unsigned Bits;
+  unsigned MaxWavesPerEU;
+  unsigned MaxHWAddressableLocalMemorySize;
+  unsigned LDSBankCount;
+};
