+
+static const IsaTableEntry *getIsaTableEntry(GPUKind AK) {
+  for (const IsaTableEntry &E : IsaTable)
+    if (E.Kind == AK)
+      return &E;
+  return nullptr;
+}
+
+class AMDGPUFeatureBitset {
+  unsigned Bits;
+
+public:
+  AMDGPUFeatureBitset(unsigned Bits = 0) : Bits(Bits) {}
+  bool test(unsigned Feature) const { return Bits & Feature; }
+};
+
+static AMDGPUFeatureBitset getFeatureBitset(GPUKind AK) {
+  const IsaTableEntry *E = getIsaTableEntry(AK);
+  return AMDGPUFeatureBitset(E ? E->Bits : 0);
+}
+
+// The numeric helpers mirror the LLVM 24 definitions in
+// llvm/lib/TargetParser/AMDGPUTargetParser.cpp.  getIsaMetadata() rejects
+// GPUs that are missing from IsaTable before any of these runs, so a null
+// entry cannot leak into published metadata.
+static unsigned getLocalMemorySize(GPUKind AK, bool FullSIMDMode) {
+  const IsaTableEntry *E = getIsaTableEntry(AK);
+  // gfx6 and gfx10/11/12 address half of the physical block.
+  unsigned Size = E ? E->MaxHWAddressableLocalMemorySize : 32768;
+  if (getFeatureBitset(AK).test(FEAT_HALF_ADDRESSABLE_PHYSICAL_LOCAL_MEMORY))
+    Size *= 2;
+
+  // In half-SIMD mode the work-group reaches only half of the block.
+  if (!FullSIMDMode)
+    Size /= 2;
+
+  return Size;
+}
+
+static unsigned getMaxWavesPerEU(GPUKind AK) {
+  const IsaTableEntry *E = getIsaTableEntry(AK);
+  return E ? E->MaxWavesPerEU : 10;
+}
+
+static unsigned getMaxFlatWorkGroupSize() {
+  // Some subtargets allow encoding 2048, but this isn't tested or supported.
+  return 1024;
+}
+
+static unsigned getVGPRAllocGranule(GPUKind AK, bool IsWave32) {
+  const AMDGPUFeatureBitset Features = getFeatureBitset(AK);
+  if (Features.test(FEAT_GFX90A_INSTS))
+    return 8;
+  if (Features.test(FEAT_1536_PHYSICAL_VGPRS))
+    return IsWave32 ? 24 : 12;
+  if (Features.test(FEAT_GFX10_3_INSTS))
+    return IsWave32 ? 16 : 8;
+  return IsWave32 ? 8 : 4;
+}
+
+static unsigned getTotalNumVGPRs(GPUKind AK, bool IsWave32) {
+  const AMDGPUFeatureBitset Features = getFeatureBitset(AK);
+  if (Features.test(FEAT_GFX90A_INSTS))
+    return 512;
+  if (!Features.test(FEAT_GFX10_INSTS))
+    return 256;
+  if (Features.test(FEAT_1536_PHYSICAL_VGPRS))
+    return IsWave32 ? 1536 : 768;
+  return IsWave32 ? 1024 : 512;
+}
+
+static unsigned getAddressableNumVGPRs(GPUKind AK, bool IsWave32) {
+  const AMDGPUFeatureBitset Features = getFeatureBitset(AK);
+  // The unified register file makes the AGPRs addressable as VGPRs.
+  if (Features.test(FEAT_GFX90A_INSTS))
+    return 512;
+  if (Features.test(FEAT_1024_ADDRESSABLE_VGPRS))
+    return IsWave32 ? 1024 : 512;
+  return 256;
+}
+
+static unsigned getLDSBankCount(GPUKind AK) {
+  const IsaTableEntry *E = getIsaTableEntry(AK);
+  return E ? E->LDSBankCount : 32;
+}
