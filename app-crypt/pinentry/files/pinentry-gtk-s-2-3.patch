+   Based on pinentry-gtk.c
    Copyright (C) 1999 Robert Bihlmeyer <robbe@orcus.priv.at>
    Copyright (C) 2001, 2002, 2007, 2015 g10 Code GmbH
    Copyright (C) 2004 by Albrecht Dreß <albrecht.dress@arcor.de>
diff --git a/gtk+-2/Makefile.am b/gtk+/Makefile.am
similarity index 86%
rename from gtk+-2/Makefile.am
rename to gtk+/Makefile.am
index 0523b0b..b578ae8 100644
--- a/gtk+-2/Makefile.am
+++ b/gtk+/Makefile.am
@@ -19,7 +19,7 @@
 
 ## Process this file with automake to produce Makefile.in
 
-bin_PROGRAMS = pinentry-gtk-2
+bin_PROGRAMS = pinentry-gtk
 
 if FALLBACK_CURSES
 ncurses_include = $(NCURSES_INCLUDE)
@@ -29,9 +29,9 @@ ncurses_include =
 libcurses =
 endif
 
-AM_CPPFLAGS = $(COMMON_CFLAGS) $(GTK2_CFLAGS) $(ncurses_include) \
+AM_CPPFLAGS = $(COMMON_CFLAGS) $(GTK3_CFLAGS) $(ncurses_include) \
 	-I$(top_srcdir)/secmem -I$(top_srcdir)/pinentry
 LDADD = ../pinentry/libpinentry.a ../secmem/libsecmem.a \
-	$(COMMON_LIBS) $(GTK2_LIBS) $(libcurses)
+	$(COMMON_LIBS) $(GTK3_LIBS) $(libcurses)
 
-pinentry_gtk_2_SOURCES = pinentry-gtk-2.c
+pinentry_gtk_SOURCES = pinentry-gtk.c
diff --git a/gtk+-2/pinentry-gtk-2.c b/gtk+/pinentry-gtk.c
similarity index 99%
rename from gtk+-2/pinentry-gtk-2.c
rename to gtk+/pinentry-gtk.c
index 32112ae..19dfecb 100644
--- a/gtk+-2/pinentry-gtk-2.c
+++ b/gtk+/pinentry-gtk.c
@@ -1,9 +1,9 @@
-/* pinentry-gtk-2.c
+/* pinentry-gtk.c
  * Copyright (C) 1999 Robert Bihlmeyer <robbe@orcus.priv.at>
  * Copyright (C) 2001, 2002, 2007, 2015 g10 Code GmbH
  * Copyright (C) 2004 by Albrecht Dreß <albrecht.dress@arcor.de>
  *
- * pinentry-gtk-2 is a pinentry application for the Gtk+-2 widget set.
+ * pinentry-gtk is a pinentry application for the Gtk+-3 widget set.
  * It tries to follow the Gnome Human Interface Guide as close as
  * possible.
  *
@@ -54,7 +54,7 @@
 #endif
 
 
-#define PGMNAME "pinentry-gtk2"
+#define PGMNAME "pinentry-gtk"
 
 #ifndef VERSION
 #  define VERSION
-- 
2.42.0

