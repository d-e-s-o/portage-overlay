+/* Adjusts result of reading a key to what the main loop expects. */
+static int
+finish_key(int result, wint_t *c)
+{
+	if(result == KEY_CODE_YES)
+	{
+		*c = K(*c);
+	}
+	else if(*c == L'\0')
+	{
+		*c = WC_C_SPACE;
+	}
+
+	return result;
+}
+
+/* Performs a final round of background bookkeeping and then blocks until
+ * something interesting happens: input arrives, a directory displayed in one
+ * of the views changes (reported by its inotify descriptor, no polling), or a
+ * signal like SIGWINCH interrupts the wait.  Returns like
+ * get_char_async_loop() does. */
+static int
+get_char_idle(WINDOW *win, wint_t *c)
+{
+	for(;;)
+	{
+		if(should_check_views_for_changes())
+		{
+			check_view_for_changes(curr_view);
+			check_view_for_changes(other_view);
+		}
+
+		process_scheduled_updates();
+
+		if(curr_stats.ipc != NULL)
+		{
+			ipc_check(curr_stats.ipc);
+		}
+
+		if(vcache_check(&is_previewed))
+		{
+			stats_redraw_later();
+		}
+
+		update_hardware_cursor();
+
+		if(input_queue[0] != L'\0')
+		{
+			*c = input_queue[0];
+			wmemmove(input_queue, input_queue + 1, wcslen(input_queue));
+			return OK;
+		}
+
+		/* Pick up any input that curses has already buffered. */
+		wtimeout(win, /*delay=*/0);
+		int result = compat_wget_wch(win, c);
+		if(result != ERR)
+		{
+			return finish_key(result, c);
+		}
+
+		struct pollfd fds[3];
+		nfds_t nfds = 0;
+
+		fds[nfds].fd = STDIN_FILENO;
+		fds[nfds].events = POLLIN;
+		++nfds;
+
+		/* Wait on directory watchers as well so that external changes are
+		 * noticed instantly without waking up periodically. */
+		int fd = fswatch_get_fd(curr_view->watch);
+		if(fd != -1)
+		{
+			fds[nfds].fd = fd;
+			fds[nfds].events = POLLIN;
+			++nfds;
+		}
+
+		fd = fswatch_get_fd(other_view->watch);
+		if(fd != -1)
+		{
+			fds[nfds].fd = fd;
+			fds[nfds].events = POLLIN;
+			++nfds;
+		}
+
+		int ready = poll(fds, nfds, /*timeout=*/-1);
+		if(ready == -1)
+		{
+			/* Most likely EINTR (e.g. terminal resize), let the main loop deal
+			 * with it. */
+			return ERR;
+		}
+
+		if((fds[0].revents & POLLIN) != 0)
+		{
+			wtimeout(win, /*delay=*/-1);
+			result = compat_wget_wch(win, c);
+			return finish_key(result, c);
+		}
+
+		/* A watched directory changed; the bookkeeping above will reload
+		 * affected views and drain watcher descriptors in the process. */
+	}
+}
