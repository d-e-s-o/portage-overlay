From 306b46386102326249f697a98ad7e7e6ce744612 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Daniel=20M=C3=BCller?= <deso@posteo.net>
Date: Thu, 12 Nov 2026 19:38:05 -0800
Subject: [PATCH] Bound hw_params refinement loops to avoid livelock

The hw_params refinement rule engine (snd_pcm_hw_refine and friends)
assumes each pass strictly narrows the configuration space, so its
"iterate until unchanged" loops are expected to terminate quickly.
Under some multi-layer plugin chains (observed here: plug -> equal
(alsaequal) -> plug -> softvol -> plug -> route -> multi -> dmix),
continuous open-endpoint time intervals combined with integer
frame/rate relations can make the slave-refinement loop converge at
+/-1 Hz per iteration over rate intervals of ~4e9 values, which is a
practical livelock: 100% CPU, no progress, application frozen (e.g.
Thunderbird hanging when its event sounds open the default PCM).

Fix this defensively by bounding refinement work:
  - one top-level snd_pcm_hw_refine() session may not exceed
    SND_REFINE_WORK_LIMIT (1M) loop iterations (thread-local counter),
  - snd_pcm_hw_refine_slave() loop capped at 20000 iterations,
  - snd_pcm_hw_refine_soft() rule loop capped at 50000 passes,
  - snd_pcm_multi_hw_refine() loop capped at 20000 iterations,
  - snd_pcm_hw_param_refine_multiple() scan capped at 100000 steps
    (falls back to the regular near-refinement).
A non-converging chain now fails cleanly with -EINVAL and a message
("Non-converging hw refinement rules ...") after well under a second
instead of spinning forever. A legitimate full-chain refinement was
measured at <=300k work units, so the limits have >3x headroom.
---
 src/pcm/pcm_multi.c  | 22 ++++++++++++--
 src/pcm/pcm_params.c | 71 +++++++++++++++++++++++++++++++++++++++++---
 2 files changed, 87 insertions(+), 6 deletions(-)

diff --git a/src/pcm/pcm_multi.c b/src/pcm/pcm_multi.c
index f0f32f..e1b412 100644
--- a/src/pcm/pcm_multi.c
+++ b/src/pcm/pcm_multi.c
@@ -28,6 +28,13 @@
   
 #include "pcm_local.h"
 #include "pcm_generic.h"
+
+/* refinement convergence guard, see pcm/pcm_params.c */
+extern __thread unsigned int snd_refine_depth;
+extern __thread unsigned int snd_refine_work;
+#ifndef SND_REFINE_WORK_LIMIT
+#define SND_REFINE_WORK_LIMIT	(1U << 20)
+#endif
 #include <stdio.h>
 #include <stdlib.h>
 #include <unistd.h>
@@ -268,6 +275,7 @@ static int snd_pcm_multi_hw_refine(snd_pcm_t *pcm, snd_pcm_hw_params_t *params)
 	snd_pcm_hw_params_t sparams[multi->slaves_count];
 	int err;
 	unsigned int cmask, changed;
+	unsigned int iter;
 	err = snd_pcm_multi_hw_refine_cprepare(pcm, params);
 	if (err < 0)
 		return err;
@@ -280,7 +288,15 @@ static int snd_pcm_multi_hw_refine(snd_pcm_t *pcm, snd_pcm_hw_params_t *params)
 			return err;
 		}
 	}
-	do {
+	for (iter = 0;; iter++) {
+		if (iter > 20000U ||
+		    snd_refine_work > SND_REFINE_WORK_LIMIT) {
+			SNDERR("hw refinement multi loop on '%s' does not "
+			       "converge, aborting to avoid livelock",
+			       pcm->name);
+			return -EINVAL;
+		}
+		snd_refine_work++;
 		cmask = params->cmask;
 		params->cmask = 0;
 		for (k = 0; k < multi->slaves_count; ++k) {
@@ -302,7 +318,9 @@ static int snd_pcm_multi_hw_refine(snd_pcm_t *pcm, snd_pcm_hw_params_t *params)
 		params->cmask |= cmask;
 		if (err < 0)
 			return err;
-	} while (changed);
+		if (!changed)
+			break;
+	}
 	return 0;
 }
 
diff --git a/src/pcm/pcm_params.c b/src/pcm/pcm_params.c
index 05bfe3..23d2f1 100644
--- a/src/pcm/pcm_params.c
+++ b/src/pcm/pcm_params.c
@@ -21,6 +21,37 @@
   
 #include "pcm_local.h"
 
+/*
+ * Refine-convergence guard.
+ *
+ * The hw_params refinement rules are expected to monotonically narrow
+ * the configuration space, hence a refinement session should converge
+ * quickly.  Certain corner cases (e.g. continuous open-endpoint time
+ * intervals combined with integer frame/rate relations in multi-layer
+ * plugin chains) can make the rule system converge by +/-1 step per
+ * iteration over intervals of up to 2^32 values, which is effectively
+ * a livelock (100% CPU, no progress).  Bound the total number of
+ * loop iterations spent in one top-level snd_pcm_hw_refine() session
+ * and fail cleanly with -EINVAL instead of spinning forever.
+ */
+#define SND_REFINE_WORK_LIMIT	(1U << 20)
+#define SND_REFINE_SLAVE_LOOP_LIMIT	(20000U)
+#define SND_REFINE_SOFT_LOOP_LIMIT	(50000U)
+
+__thread unsigned int snd_refine_depth;
+__thread unsigned int snd_refine_work;
+
+static int snd_refine_work_add(unsigned int n, const char *name)
+{
+	snd_refine_work += n;
+	if (snd_refine_work > SND_REFINE_WORK_LIMIT) {
+		SNDERR("Non-converging hw refinement rules on '%s', "
+		       "aborting to avoid livelock", name ? name : "?");
+		return -EINVAL;
+	}
+	return 0;
+}
+
 #ifndef NDEBUG
 /*
  * dump hw_params when $LIBASOUND_DEBUG is set to >= 1
@@ -1005,8 +1036,11 @@ int snd_pcm_hw_param_refine_multiple(snd_pcm_t *pcm,
 	const snd_interval_t *st = hw_param_interval_c(params, var);
 	if (snd_interval_single(it)) {
 		unsigned int best = snd_interval_min(it), cur, prev;
+		unsigned int tries = 0;
 		cur = best;
 		for (;;) {
+			if (++tries > 100000)
+				break;
 			if (st->max < cur || (st->max == cur && st->openmax))
 				break;
 			if (it->min <= cur && ! (it->min == cur && st->openmin)) {
@@ -2079,6 +2113,7 @@ int snd_pcm_hw_refine_soft(snd_pcm_t *pcm ATTRIBUTE_UNUSED, snd_pcm_hw_params_t
 	unsigned int rstamps[RULES];
 	unsigned int vstamps[SND_PCM_HW_PARAM_LAST_INTERVAL + 1];
 	unsigned int stamp = 2;
+	unsigned int iter;
 	int changed, again;
 #ifdef RULES_DEBUG
 	snd_output_t *log;
@@ -2113,8 +2148,16 @@ int snd_pcm_hw_refine_soft(snd_pcm_t *pcm ATTRIBUTE_UNUSED, snd_pcm_hw_params_t
 		rstamps[k] = 0;
 	for (k = 0; k <= SND_PCM_HW_PARAM_LAST_INTERVAL; k++)
 		vstamps[k] = (params->rmask & (1 << k)) ? 1 : 0;
-	do {
+	for (iter = 0;; iter++) {
+		if (iter > SND_REFINE_SOFT_LOOP_LIMIT) {
+			SNDERR("hw refinement rule loop on '%s' exceeds %u "
+			       "passes, aborting to avoid livelock",
+			       pcm ? pcm->name : "?", SND_REFINE_SOFT_LOOP_LIMIT);
+			return -EINVAL;
+		}
 		again = 0;
+		if (snd_refine_work_add(1, pcm ? pcm->name : NULL) < 0)
+			return -EINVAL;
 		for (k = 0; k < RULES; k++) {
 			const snd_pcm_hw_rule_t *r = &refine_rules[k];
 			unsigned int d;
@@ -2155,7 +2198,9 @@ int snd_pcm_hw_refine_soft(snd_pcm_t *pcm ATTRIBUTE_UNUSED, snd_pcm_hw_params_t
 				goto _err;
 			stamp++;
 		}
-	} while (again);
+		if (!again)
+			break;
+	}
 	if (!params->msbits) {
 		i = hw_param_interval(params, SND_PCM_HW_PARAM_SAMPLE_BITS);
 		if (snd_interval_single(i))
@@ -2224,6 +2269,7 @@ int snd_pcm_hw_refine_slave(snd_pcm_t *pcm, snd_pcm_hw_params_t *params,
 	snd_pcm_hw_params_t sparams;
 	int err;
 	unsigned int cmask, changed;
+	unsigned int iter;
 #ifdef RULES_DEBUG
 	snd_output_stdio_attach(&log, stderr, 0);
 #endif
@@ -2238,7 +2284,16 @@ int snd_pcm_hw_refine_slave(snd_pcm_t *pcm, snd_pcm_hw_params_t *params,
 #ifdef RULES_DEBUG
 	snd_output_printf(log, "hw_refine_slave - enter '%s'\n", pcm->name);
 #endif
-	do {
+	for (iter = 0;; iter++) {
+		if (iter > SND_REFINE_SLAVE_LOOP_LIMIT) {
+			SNDERR("hw refinement slave loop on '%s' exceeds %u "
+			       "iterations, aborting to avoid livelock",
+			       pcm ? pcm->name : "?", SND_REFINE_SLAVE_LOOP_LIMIT);
+			return -EINVAL;
+		}
+		err = snd_refine_work_add(1, pcm ? pcm->name : NULL);
+		if (err < 0)
+			return err;
 		cmask = params->cmask;
 		params->cmask = 0;
 #ifdef RULES_DEBUG
@@ -2293,7 +2348,9 @@ int snd_pcm_hw_refine_slave(snd_pcm_t *pcm, snd_pcm_hw_params_t *params,
 #ifdef RULES_DEBUG
 		snd_output_printf(log, "refine_soft ok '%s'\n", pcm->name);
 #endif
-	} while (changed);
+		if (!changed)
+			break;
+	}
 #ifdef RULES_DEBUG
 	snd_output_printf(log, "refine_slave - leave '%s'\n", pcm->name);
 	snd_output_close(log);
@@ -2359,6 +2416,9 @@ static int snd_pcm_sw_params_default(snd_pcm_t *pcm, snd_pcm_sw_params_t *params
 int snd_pcm_hw_refine(snd_pcm_t *pcm, snd_pcm_hw_params_t *params)
 {
 	int res;
+	unsigned int outer = (snd_refine_depth++ == 0);
+	if (outer)
+		snd_refine_work = 0;
 #ifdef REFINE_DEBUG
 	snd_output_t *log;
 	snd_output_stdio_attach(&log, stderr, 0);
@@ -2377,6 +2437,9 @@ int snd_pcm_hw_refine(snd_pcm_t *pcm, snd_pcm_hw_params_t *params)
 	snd_pcm_hw_params_dump(params, log);
 	snd_output_close(log);
 #endif
+	if (outer)
+		snd_refine_work = 0;
+	snd_refine_depth--;
 	return res;
 }
 
-- 
2.56.1

